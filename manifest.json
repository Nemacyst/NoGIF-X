{
  "manifest_version": 3,
  "name": "NoGIF X",
  "version": "1.0",
  "description": "Hides GIFs on x.com and twitter.com with a click-to-show placeholder.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
